# Blacksite — environment template (safe to commit). Copy to `.env` (gitignored) and fill in.
# 🔴 `.env` holds ALL secrets — never commit it. See README.md / GETTING_STARTED.md.

# ============================================================================
# Active instance
# ============================================================================
ACTIVE_INSTANCE='_TEMPLATE'          # set to your instance name once scaffolded, e.g. MR-MKT

# ============================================================================
# LLM stack (see config/llm_providers.yaml; switch with scripts/switch_llm_provider.py)
# ============================================================================
# Default provider's tier→model map is written here by switch_llm_provider.py.
# Stage 3 / audit use the HOST CLI OAuth session (claude.exe / codex.exe) — keep it warm
# for headless runs (processors/oauth_keepalive.py). If you use a raw API key instead:
ANTHROPIC_OAUTH_TOKEN=''             # sk-ant-oat01-... from `claude setup-token` (host-OAuth path)
# ANTHROPIC_API_KEY=''               # only if using a direct API key instead of host OAuth
# OPENAI_API_KEY=''                  # if provider=codex / GPT
OLLAMA_HOST='http://127.0.0.1:11434' # local Stage 1 vision model (e.g. qwen2.5vl:7b)

# Optional per-stage model overrides (else taken from config/llm_providers.yaml):
# STAGE2_MODEL='claude-haiku-4-5-20251001'
# STAGE3_MODEL='claude-sonnet-4-6'
# AUDIT_MODEL='claude-sonnet-4-6'

# ============================================================================
# Personas — ONE block per persona. Keys are PERSONA_<id>_*  (id matches personas/<id>/).
# 🔴 Identity-axes isolation (CLAUDE.md §9.1a): each persona's email/phone/proxy is UNIQUE.
# ============================================================================
PERSONA_P01_EMAIL='persona01@example.com'
PERSONA_P01_PASSWORD='REPLACE'
PERSONA_P01_PHONE='+0000000000'           # this persona's own number
PERSONA_P01_TOTP_SECRET=''                # base32 secret if 2FA via authenticator app (pyotp)
PERSONA_P01_PROXY='http://user:pass@residential-endpoint:port'   # per-persona residential IP

PERSONA_P02_EMAIL='persona02@example.com'
PERSONA_P02_PASSWORD='REPLACE'
PERSONA_P02_PHONE='+0000000000'
PERSONA_P02_PROXY=''

# Telegram personas use telethon (phone + password). Add TG_PERSONA_NN_* as needed:
TG_PERSONA_01_PHONE='+0000000000'
TG_PERSONA_01_PASSWORD='REPLACE'
TG_API_ID=''                               # from my.telegram.org
TG_API_HASH=''

# Operator DM bridge (optional — receive briefs / drive the engine via Telegram):
TG_BRIDGE_BOT_TOKEN=''                      # @BotFather token
TG_BRIDGE_OPERATOR_ID=''                    # your numeric Telegram user id (allow-list)

# Email OTP poller (optional — auto-read register OTPs from a persona inbox via IMAP):
IMAP_HOST=''
IMAP_USER=''
IMAP_APP_PASSWORD=''

# ============================================================================
# Proxy / VPN (if using a single shared endpoint instead of per-persona proxies)
# ============================================================================
VPN_USERNAME=''
VPN_PASSWORD=''
VPN_ENDPOINT=''

# (Add platform-specific blocks as accounts come online —
#  REDDIT_PERSONA_NN_*, DISCORD_PERSONA_NN_*, X_PERSONA_NN_*, GOOGLE_PERSONA_NN_*, etc.)
